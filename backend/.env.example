# ============================================================
# CodeVerse – Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your own values.
# NEVER commit your actual .env file to version control.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Get a free cluster at https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/codeverse?retryWrites=true&w=majority

# --- JWT ---
# Use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRE=7d

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- GitHub OAuth ---
# Create an OAuth App at https://github.com/settings/developers
# Authorised callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# --- Platform API Keys ---
# GitHub Personal Access Token (needs read:user scope for GitHub stats)
GITHUB_TOKEN=your_github_personal_access_token_here

# Codeforces – generate at https://codeforces.com/settings/api
CODEFORCES_API_KEY=your_codeforces_api_key_here
CODEFORCES_API_SECRET=your_codeforces_api_secret_here

# CodeChef – register at https://api.codechef.com/
CODECHEF_CLIENT_ID=your_codechef_client_id_here
CODECHEF_CLIENT_SECRET=your_codechef_client_secret_here

# HackerRank (optional)
HACKERRANK_API_KEY=your_hackerrank_api_key_here

# LeetCode session cookie (optional – used as fallback if GraphQL fails)
LEETCODE_SESSION=your_leetcode_session_cookie_here

# --- Email (for contest reminders) ---
# For Gmail, create an App Password at https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password_here
